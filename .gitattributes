# Auto detect text files and perform LF normalization
* text=auto

# The needflow conformance corpus is shared byte-for-byte with ubCode and checksummed in
# its own manifest, so its working-tree bytes must stay canonical on every platform --
# `text=auto` above would otherwise hand Windows a CRLF checkout. This later, more
# specific pattern wins over it. The harness additionally normalises line endings before
# hashing, so the contract holds even where this pin is absent.
packages/sphinx-needs/tests/conformance/needflow/** text eol=lf

# The variant-condition conformance corpus is the second such file, shared byte-for-byte
# with ubCode in the same way and pinned by a digest fence in that repository. taplo leaves
# it alone today, but its defaults are not a contract, so the exclude in
# .pre-commit-config.yaml states the intent -- and this line keeps the working-tree bytes
# canonical on Windows regardless.
packages/sphinx-mounts/tests/fixtures/variant_condition_conformance.toml text eol=lf

# The `ubproject.toml` reading conformance corpus is the third, and the one this repository is the
# repository of RECORD for: ubCode is to vendor it byte-for-byte, so its bytes must be the
# same on every platform. Its `toml = '...'` bodies are case inputs, so a CRLF checkout would change
# what the cases test.
packages/ub-project/tests/fixtures/ubproject_reading_conformance.toml text eol=lf

# sphinx-codelinks' extraction corpus is shared byte-for-byte with ubCode, which copies its
# YAML cases and takes the snapshots as the expected output of its parity test, so their
# bytes must be the same on every platform. The tests do not depend on it: YAML normalises
# line breaks, the harness writes each case's source as exact bytes, and the snapshots are
# read in text mode.
packages/sphinx-codelinks/tests/data/extraction/** text eol=lf
packages/sphinx-codelinks/tests/__snapshots__/** text eol=lf

# The committed PlantUML jar. `text=auto` at the top would otherwise ask git to classify a
# 30 MB zip on every checkout; git's own detection gets it right, and this states it.
vendor/plantuml/*.jar binary
