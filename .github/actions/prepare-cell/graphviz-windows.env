# The one graphviz the Windows cells install: the Graphviz project's own portable build, from
# its GitLab release, verified against the sha256 the release publishes beside it. Sourced by
# `action.yml`'s "Install graphviz (windows)" step, and its hash is the `actions/cache` key in
# `test-package.yaml` and `test-extensions.yaml`, so editing this file is what retires the
# cached zip.
#
# To bump: set the version, then copy the hash from the release's own
# `<asset>.sha256` file (the release page lists it next to the zip).
GRAPHVIZ_VERSION=16.1.0
GRAPHVIZ_SHA256=733e49626c492242eb8dca30ea627b6ead20710e207998c7933b4909d92d6abc
GRAPHVIZ_ASSET="windows_10_cmake_Release_Graphviz-${GRAPHVIZ_VERSION}-win64.zip"
GRAPHVIZ_URL="https://gitlab.com/api/v4/projects/4207231/packages/generic/graphviz-releases/${GRAPHVIZ_VERSION}/${GRAPHVIZ_ASSET}"
