    "version": "0.2.0",
    "configurations": [
        {
            "name": "sphinx-ai-index (test-basic)",
            "type": "debugpy",
            "request": "launch",
            "module": "sphinx",
            "args": [
                "-W",
                "--keep-going",
                "-v",
                "-b",
                "html",
                ".",
                "_build/html"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/tests/roots/test-basic/",
            "justMyCode": false,
        }
    ]
}
