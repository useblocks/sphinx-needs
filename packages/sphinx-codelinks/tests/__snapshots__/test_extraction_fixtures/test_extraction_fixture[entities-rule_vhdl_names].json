    "tagged_scope": "architecture rtl of counter is\n  -- @State type, IMPL_N_ENUM, impl\n  type state_t is (IDLE, RUN);\n  -- @Pair record, IMPL_N_RECORD, impl\n  type pair_t is record\n    a, b : natural;\n  end record;\n  -- @Byte subtype, IMPL_N_SUBTYPE, impl\n  subtype byte_t is natural range 0 to 255;\n  -- @Count signal, IMPL_N_SIGNAL, impl\n  signal count : natural := 0;\n  -- @Max constant, IMPL_N_CONSTANT, impl\n  constant MAX : natural := 10;\n  -- @Fifo component, IMPL_N_COMPONENT, impl\n  component fifo is\n    port (d : in std_logic); -- @Fifo port, IMPL_N_COMPONENT_PORT, impl\n  end component fifo;\n  -- @Next count, IMPL_N_FUNCTION, impl\n  function next_count(c : natural) return natural is\n  begin\n    return c + 1;\n  end function next_count;\nbegin\n  -- @Tick process, IMPL_N_PROCESS, impl\n  tick : process (clk)\n    -- @Step variable, IMPL_N_VARIABLE, impl\n    variable step : natural;\n  begin\n    count <= next_count(count);\n  end process tick;\n  -- @Fifo instance, IMPL_N_INSTANCE, impl\n  u_fifo : fifo port map (d => clk);\n  -- @Lanes, IMPL_N_GENERATE, impl\n  lanes : for i in 0 to 3 generate\n    -- @Lane process, IMPL_N_GEN_PROCESS, impl\n    lane : process (clk) begin end process lane;\n  end generate lanes;\n  -- @Output, IMPL_N_ASSIGN, impl\n  drive : q <= count;\n  -- @Unlabelled process, IMPL_N_UNLABELLED, impl\n  process (clk) begin end process;\nend architecture rtl;",
