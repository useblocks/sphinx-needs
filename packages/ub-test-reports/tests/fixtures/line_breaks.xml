<?xml version="1.0" encoding="UTF-8"?>
<!-- One failed case per line-break character an XML report can carry (CR, CR+LF, NEL, LINE SEPARATOR,
     PARAGRAPH SEPARATOR): its failure message, failure text and captured output each hold the character
     followed by a raw directive at column 0 and a marker element. XML 1.0 does not allow VT, FF, FS, GS or RS
     even as character references; `line_breaks.json` carries all ten. -->
<testsuite name="S" tests="5" errors="0" failures="5" skipped="0" time="0.5">
  <testcase classname="C" name="t_CR" time="0.1">
    <failure message="before&#13;.. raw:: html&#13;&#13;   &lt;b&gt;M_MSG_CR&lt;/b&gt;&#13;after">before&#13;.. raw:: html&#13;&#13;   &lt;b&gt;M_TXT_CR&lt;/b&gt;&#13;after</failure>
    <system-out>before&#13;.. raw:: html&#13;&#13;   &lt;b&gt;M_OUT_CR&lt;/b&gt;&#13;after</system-out>
  </testcase>
  <testcase classname="C" name="t_CRLF" time="0.1">
